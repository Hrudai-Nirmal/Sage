{
  "manifest_version": 3,
  "name": "Sage Observer",
  "version": "0.1.0",
  "description": "Locally records permitted browser activity for Sage.",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "alarms",
    "idle",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_title": "Sage Observer"
  },
  "options_page": "options.html"
}
