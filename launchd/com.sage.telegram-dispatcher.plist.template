<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.sage.telegram-dispatcher</string>
  <key>ProgramArguments</key><array><string>__SAGE_DATA_ROOT__/runtime/sage-core/bin/python</string><string>__SAGE_PROJECT_ROOT__/scripts/run-telegram-dispatcher.py</string></array>
  <key>EnvironmentVariables</key><dict><key>SAGE_DATA_ROOT</key><string>__SAGE_DATA_ROOT__</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
