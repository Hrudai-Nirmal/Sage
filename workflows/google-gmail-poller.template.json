      "parameters": {
        "jsCode": "const gmailMessage = $json;\nconst headers = Object.fromEntries((gmailMessage.payload?.headers ?? []).map((header) => [String(header.name).toLowerCase(), String(header.value ?? '')]));\nconst decodeBody = (encodedBody) => { const normalized = String(encodedBody ?? '').replace(/-/g, '+').replace(/_/g, '/'); const padded = normalized + '='.repeat((4 - normalized.length % 4) % 4); return Buffer.from(padded, 'base64').toString('utf8'); };\nconst collectParts = (part, mimeType) => { const ownText = part?.mimeType === mimeType && part.body?.data ? [decodeBody(part.body.data)] : []; return ownText.concat((part?.parts ?? []).flatMap((childPart) => collectParts(childPart, mimeType))); };\nconst plainText = collectParts(gmailMessage.payload, 'text/plain').join('\\n').trim();\nconst htmlText = collectParts(gmailMessage.payload, 'text/html').join('\\n').replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim();\nreturn [{ json: { accountEmail: '__PERSONAL_WORK_EMAIL__', accountKey: 'personal-work', bodyText: (plainText || htmlText).slice(0, 50000), internalDate: String(gmailMessage.internalDate), labelIds: Array.isArray(gmailMessage.labelIds) ? gmailMessage.labelIds.slice(0, 100) : [], messageId: String(gmailMessage.id), recipients: [headers.to, headers.cc, headers.bcc].filter(Boolean).slice(0, 100), sender: (headers.from ?? '').slice(0, 2000), snippet: String(gmailMessage.snippet ?? '').slice(0, 10000), subject: (headers.subject ?? '').slice(0, 2000), threadId: String(gmailMessage.threadId) } }];"
