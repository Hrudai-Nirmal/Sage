        "jsCode": "const events = Array.isArray($json.items) ? $json.items : [];\nreturn events.map((event) => ({ json: { accountEmail: '__PERSONAL_WORK_EMAIL__', accountKey: 'personal-work', attendees: (event.attendees ?? []).map((attendee) => String(attendee.email ?? '')).filter(Boolean).slice(0, 100), description: String(event.description ?? '').slice(0, 50000), endAt: String(event.end?.dateTime ?? event.end?.date ?? ''), eventId: String(event.id), htmlLink: String(event.htmlLink ?? '').slice(0, 2000), location: String(event.location ?? '').slice(0, 2000), startAt: String(event.start?.dateTime ?? event.start?.date ?? ''), status: String(event.status ?? 'confirmed'), summary: String(event.summary ?? '').slice(0, 2000), updatedAt: String(event.updated) } }));"
